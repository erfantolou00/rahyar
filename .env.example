# Copy to .env.local. Do not put real secrets in this file.

# Project URL from Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key. Safe in the browser. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The single account allowed to sign in. Server-only.
ALLOWED_USER_EMAIL=

# Bale bot token from @botfather in the Bale app. Server-only.
BALE_BOT_TOKEN=

# Web Push keys. Public key is safe in the browser. Private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Secret key from Supabase → Project Settings → API Keys.
# Server-only. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# Authorizes GET/POST /api/cron/weekly-report. Vercel Cron sends Authorization: Bearer.
# Server-only.
CRON_SECRET=

# GapGPT Chat Completions. Server-only.
# Docs: https://api.gapgpt.app/v1 and https://gapgpt.app/platform-v2/docs/models/gpt-5-6
# The app calls gpt-6-luna. If that id is rejected, set GAPGPT_MODEL=gpt-5.6-luna.
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-6-luna
