# Copy to .env.local. Do not put real secrets in this file.

# Project URL from Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key. Safe in the browser. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The single account allowed to sign in. Server-only.
ALLOWED_USER_EMAIL=
