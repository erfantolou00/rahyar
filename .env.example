# Copy to .env.local. Do not put real secrets in this file.

# Project URL from Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key. Safe in the browser. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The single account allowed to sign in. Server-only.
ALLOWED_USER_EMAIL=

# Bot token from @BotFather. Server-only. Never prefix with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=

# Bearer secret for POST /api/alerts/telegram when a database webhook or cron calls it.
# Server-only. The logged-in session can call the same route without this secret.
TELEGRAM_DISPATCH_SECRET=

# Secret key from Supabase → Project Settings → API Keys.
# Used only by the webhook route. Never expose it to the browser.
SUPABASE_SECRET_KEY=
