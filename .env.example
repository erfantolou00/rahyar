# Copy to .env.local. Do not put real secrets in this file.

# Project URL from Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key. Safe in the browser. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The single account allowed to sign in. Server-only.
ALLOWED_USER_EMAIL=

# Server-only. Needed so the 15-minute cron can store prices without a browser session.
# Supabase → Project Settings → API keys → secret key.
SUPABASE_SECRET_KEY=

# Sent by Vercel Cron as Authorization: Bearer <value>. Use a long random string.
CRON_SECRET=
